# ollama | openai | anthropic | nvidia_nim
# ollama runs inside Compose: docker compose --profile local-llm up
LLM_PROVIDER=ollama
# Empty = provider default (llama3.1:8b for ollama, ~5 GB). The ollama-pull service downloads
# whatever is set here, e.g. qwen3:4b, llama3.2:3b or hf.co/openbmb/MiniCPM5-2B-GGUF:Q4_K_M
LLM_MODEL=
OLLAMA_BASE_URL=http://ollama:11434
# Cloud keys (LiteLLM reads these); set only the provider you use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_NIM_API_KEY=
# Seconds before an LLM call is abandoned (the job then fails instead of hanging);
# raise it (e.g. 600) for a local model on CPU
LLM_TIMEOUT=120
# true keeps the chain-of-thought of NIM reasoning models (much slower)
LLM_THINKING=false
DATABASE_URL=postgresql://engineer:password@postgres:5432/tutordb
MATERIALS_DIR=/data/materials
PDF_PARSER=pymupdf
OFFICE_PARSER=markitdown
KEEP_ORIGINALS=true
VERIFICATION_MAX_RETRIES=2
