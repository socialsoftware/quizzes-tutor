# Starting values: once the administrator saves the "Question generation model" page,
# the model, fallbacks, Ollama address, timeout and retries saved there are used instead.
# API keys are only ever read from here.
# ollama | openai | anthropic | nvidia_nim
LLM_PROVIDER=ollama
# Leave empty to use the provider default (see app/config.py)
LLM_MODEL=
OLLAMA_BASE_URL=http://ollama:11434
# Read by LiteLLM for the cloud providers; only set the one you use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_NIM_API_KEY=
# Seconds before an LLM call is abandoned (the job then fails instead of hanging)
LLM_TIMEOUT=120
# true keeps the chain-of-thought of NIM reasoning models (much slower)
LLM_THINKING=false
VERIFICATION_MAX_RETRIES=2
MATERIALS_DIR=/data/materials
# pymupdf (fast, PDFs with a text layer; falls back to marker on scans) | marker
PDF_PARSER=pymupdf
# markitdown (reads PPTX/DOCX text directly) | marker
OFFICE_PARSER=markitdown
# false deletes the uploaded file once its Markdown is saved
KEEP_ORIGINALS=true
# Postgres in production (tables live in the aqg schema); SQLite file by default
DATABASE_URL=postgresql://tutor:password@postgres:5432/tutordb
# true logs every prompt sent to the model and its reply (logger "aqg.prompts"), for debugging.
# Prompts of reply suggestions in discussions are never logged: they hold what a student wrote.
LOG_PROMPTS=false
# --- Security and limits (see data/env/aqg-service.dev.env.example for what each one does) ---
AQG_API_KEY=
LLM_REQUESTS_PER_MINUTE=30
DAILY_QUESTIONS_PER_COURSE=50
MAX_QUEUED_QUESTIONS=100
MAX_QUEUED_JOBS=20
MAX_CONCURRENT_JOBS=2
ALLOW_REQUEST_MODEL=false
