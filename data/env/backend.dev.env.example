SPRING_PROFILES_ACTIVE=dev

## Datasource
SPRING.DATASOURCE.USERNAME=engineer
SPRING.DATASOURCE.PASSWORD=password

## Jpa
SPRING.JPA.DATABASE-PLATFORM=org.hibernate.dialect.PostgreSQLDialect

## Resources
FIGURES.DIR=./data/images/
EXPORT.DIR=./data/export/
LOAD.DIR=./data/load/

## Fenix oauth
OAUTH.CONSUMER.KEY=<FENIX CLIENT KEY>
OAUTH.CONSUMER.SECRET=<FENIX SECRET>
CALLBACK.URL=http://localhost:8081/login
BASE.URL=https://fenix.tecnico.ulisboa.pt

FRAUD.SERVICE.URL=http://fraud-service:5000/

# Same value as AQG_API_KEY in aqg-service.dev.env
AQG.SERVICE.APIKEY=
# Same value as FRAUD_API_KEY in fraud-service.dev.env
FRAUD.SERVICE.APIKEY=

# Teachers' own API keys for question generation are kept encrypted. The key that encrypts them is made
# on the first start and saved in the file below, on the ./data/secrets volume (see docker-compose.yml).
# Back that folder up apart from the database, and never delete it: the saved keys could not be read.
# To use a key of your own instead, set it here (`openssl rand -base64 32`).
GENERATION_KEYS_MASTER_KEY=
GENERATION_KEYS_MASTER_KEY_FILE=/secrets/generation-master.key
