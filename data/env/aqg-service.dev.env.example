# Starting values: once the administrator saves the "Question generation model" page,
# the model, fallbacks, Ollama address, timeout and retries saved there are used instead.
# API keys are only ever read from here.
# ollama | openai | anthropic | nvidia_nim
# ollama runs inside Compose: docker compose --profile local-llm up
LLM_PROVIDER=ollama
# Empty = provider default (llama3.1:8b for ollama, ~5 GB). The ollama-pull service downloads
# whatever is set here, e.g. qwen3:4b, llama3.2:3b or hf.co/openbmb/MiniCPM5-2B-GGUF:Q4_K_M
LLM_MODEL=
OLLAMA_BASE_URL=http://ollama:11434
# Cloud keys (LiteLLM reads these); set only the provider you use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_NIM_API_KEY=
# Seconds before an LLM call is abandoned (the job then fails instead of hanging);
# raise it (e.g. 600) for a local model on CPU
LLM_TIMEOUT=120
# true keeps the chain-of-thought of NIM reasoning models (much slower)
LLM_THINKING=false
DATABASE_URL=postgresql://engineer:password@postgres:5432/tutordb
MATERIALS_DIR=/data/materials
PDF_PARSER=pymupdf
OFFICE_PARSER=markitdown
KEEP_ORIGINALS=true
VERIFICATION_MAX_RETRIES=2

# --- Security and limits ---
# The backend sends this key in every call (backend.dev.env: AQG.SERVICE.APIKEY) and the service refuses
# calls without it. Use a long random string, e.g. the output of: openssl rand -hex 32
AQG_API_KEY=
# Calls per minute to each cloud provider (NIM, OpenAI, Anthropic). NVIDIA NIM's free tier is ~40:
# stay under it. Writing a question takes 3 calls or more. 0 = no limit
LLM_REQUESTS_PER_MINUTE=30
# Questions each course may request per day (UTC) and what may wait in the queue
DAILY_QUESTIONS_PER_COURSE=50
MAX_QUEUED_QUESTIONS=100
MAX_QUEUED_JOBS=20
MAX_CONCURRENT_JOBS=2
# Off: a request cannot bring its own model, api_base or api_key
ALLOW_REQUEST_MODEL=false
# Off keeps what students write in discussions from reaching the model provider
DISCUSSION_SUGGESTIONS=true
# true logs every prompt and reply of a generation (for debugging; the logs then hold course text)
LOG_PROMPTS=false
